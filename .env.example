# Next.js Application URL (Required for NextAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth Secret (Generate via: openssl rand -base64 32)
AUTH_SECRET="your_generated_auth_secret_here"

# Neon Serverless Postgres Database URL (Required)
DATABASE_URL="postgres://user:password@hostname/dbname?sslmode=require"

# GitHub Personal Access Token (Required - needs 'repo' scope for private repos, or just standard for increased public rate limit)
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# Google Gemini API Key (Required for AI Explanations)
GEMINI_API_KEY="your_google_gemini_api_key_here"
